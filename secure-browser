#!/bin/sh
# Fail-closed WireGuard setup using routes only (no iptables/nftables needed).
# Afterwards the only ways out of the VM are:
#   * wg0 (everything), and one host route to the VPN server;
#   * if SECURE_BROWSER_PUBLISHED_PORT is set: TCP *replies* from that one
#     listening port back to the Mac, so the viewer works. A policy rule
#     matches TCP source port only; the port is held by the viewer service
#     (separate user), so the browser cannot use it to reach the Mac.
set -eu
CONF=/root/secure-browser-vpn/wireguard.conf
WG=wg0
PUB="${SECURE_BROWSER_PUBLISHED_PORT:-}"
log()  { echo "secure-browser-vpn: $*" >&2; }
fail() { log "ERROR: $*"; exit 1; }

[ "$(id -u)" = 0 ] || fail "must start as root"
[ -r "$CONF" ] || fail "config not mounted at $CONF"
umask 077
work=$(mktemp -d /run/.sbvpn.XXXXXX)
trap 'rm -rf "$work"' EXIT

vals() {
  awk -v key="$1" '
    { line = $0; sub(/#.*/, "", line) }
    tolower(line) ~ "^[[:space:]]*" tolower(key) "[[:space:]]*=" {
      sub(/^[^=]*=/, "", line); n = split(line, p, ",")
      for (i = 1; i <= n; i++) { gsub(/[[:space:]]/, "", p[i]); if (p[i] != "") print p[i] }
    }' "$CONF"
}
ADDRS=$(vals Address); DNS=$(vals DNS | grep -E '^[0-9]+(\.[0-9]+){3}$' || true)
MTU=$(vals MTU | head -n1); MTU=${MTU:-1420}
[ -n "$ADDRS" ] || fail "no Address in config"
[ -n "$DNS" ] || fail "no IPv4 DNS in config"

# Keep only keys 'wg setconf' understands; PreUp/PostUp scripts are never run.
awk '{ l = tolower($0) }
     l ~ /^[[:space:]]*(address|dns|mtu|table|preup|postup|predown|postdown|saveconfig)[[:space:]]*=/ {next}
     {print}' "$CONF" > "$work/wg.conf"

def=$(ip -4 route show default | head -n1)
GW=$(echo "$def" | awk '{for(i=1;i<NF;i++) if($i=="via") print $(i+1)}')
DEV=$(echo "$def" | awk '{for(i=1;i<NF;i++) if($i=="dev") print $(i+1)}')
[ -n "$GW" ] && [ -n "$DEV" ] || fail "no default route to start from"
SUBNET=$(ip -4 route show dev "$DEV" scope link | awk '$1 ~ /\// {print $1; exit}')

if ip link add "$WG" type wireguard 2>/dev/null; then
  kind=kernel
else
  command -v wireguard-go >/dev/null 2>&1 || fail "kernel has no WireGuard and wireguard-go is not installed"
  [ -c /dev/net/tun ] || { mkdir -p /dev/net; mknod /dev/net/tun c 10 200 2>/dev/null || true; }
  [ -c /dev/net/tun ] || fail "kernel has no WireGuard and no /dev/net/tun for wireguard-go"
  wireguard-go "$WG" || fail "wireguard-go failed to start"
  kind=userspace
fi
wg setconf "$WG" "$work/wg.conf" || fail "wg setconf rejected the config"
rm -f "$work/wg.conf"

has6=0
for a in $ADDRS; do
  case "$a" in
    *:*) ip -6 addr add "$a" dev "$WG" 2>/dev/null && has6=1 || log "IPv6 address $a not usable; IPv6 disabled" ;;
    *)   ip -4 addr add "$a" dev "$WG" ;;
  esac
done
ip link set mtu "$MTU" up dev "$WG"

EP=$(wg show "$WG" endpoints | awk '{print $2}' | head -n1)
EP_IP=${EP%:*}
echo "$EP_IP" | grep -Eq '^[0-9]+(\.[0-9]+){3}$' || fail "endpoint '$EP' is not IPv4"

# --- Kill switch: replace ALL routes. ---
ip -4 route flush table main
ip -4 route add "$EP_IP/32" via "$GW" dev "$DEV" onlink
ip -4 route add default dev "$WG"
ip -6 route flush table main 2>/dev/null || true
if [ "$has6" = 1 ]; then
  ip -6 route add default dev "$WG" 2>/dev/null || true
else
  { echo 1 > /proc/sys/net/ipv6/conf/all/disable_ipv6; } 2>/dev/null || true
fi

# --- Viewer return path (TCP replies from the published port only). ---
if [ -n "$PUB" ]; then
  [ -n "$SUBNET" ] || fail "no local subnet found for the viewer return path"
  ip -4 route add "$SUBNET" dev "$DEV" table 100
  ip -4 rule add ipproto tcp sport "$PUB" lookup 100 priority 100 2>/dev/null ||
    fail "kernel lacks port-based routing rules, so the viewer cannot work behind the kill switch"
fi

# DNS only to the VPN's resolver (reachable only through the tunnel).
{ for d in $DNS; do echo "nameserver $d"; done; } > /etc/resolv.conf 2>/dev/null || true
first=$(awk '/^nameserver/{print $2; exit}' /etc/resolv.conf 2>/dev/null || true)
echo "$DNS" | grep -Fqx "$first" || fail "could not point /etc/resolv.conf at the VPN DNS ($first)"

i=0
while [ "$i" -lt 30 ]; do
  getent hosts example.com >/dev/null 2>&1 || true
  hs=$(wg show "$WG" latest-handshakes | awk '{print $2}' | head -n1)
  [ "${hs:-0}" -gt 0 ] 2>/dev/null && { log "tunnel up ($kind WireGuard, endpoint $EP_IP)"; exit 0; }
  i=$((i+1)); sleep 0.5
done
fail "no WireGuard handshake within 15 seconds (wrong/expired config or server unreachable)"
VPNUP

