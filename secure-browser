    (apt-get install -y --no-install-recommends matchbox-window-manager || echo 'matchbox not available') && \\
    rm -rf /var/lib/apt/lists/* && mkdir -p /var/lib/xkb

# 1200 = browser (untrusted content). 1300 = viewer services (Xvnc, noVNC).
RUN useradd --create-home --uid 1200 --shell /usr/sbin/nologin browser && \\
    useradd --no-create-home --home-dir /run/vnc --uid 1300 --shell /usr/sbin/nologin vncview && \\
    mkdir -p /etc/chromium/policies/managed /etc/opt/chrome/policies/managed /root/secure-browser-vpn && \\
    chmod 700 /root

COPY secure-browser-policy.json /etc/chromium/policies/managed/secure-browser.json
COPY secure-browser-policy.json /etc/opt/chrome/policies/managed/secure-browser.json
COPY secure-chromium /usr/local/bin/secure-chromium
COPY secure-browser-vpn-up /usr/local/sbin/secure-browser-vpn-up
COPY secure-browser-vpn-selftest /usr/local/sbin/secure-browser-vpn-selftest
$audio_copy
RUN chmod 755 /usr/local/bin/secure-chromium /usr/local/sbin/secure-browser-vpn-up \\
      /usr/local/sbin/secure-browser-vpn-selftest && \\
    chmod 644 /etc/chromium/policies/managed/secure-browser.json /etc/opt/chrome/policies/managed/secure-browser.json

USER browser
ENV HOME=/home/browser
WORKDIR /home/browser
DOCKERFILE
}

context_hash() {
  local files=(Dockerfile secure-browser-policy.json secure-chromium secure-browser-vpn-up secure-browser-vpn-selftest)
  audio_on && files+=(cocoa-way-audio-relay)
  (cd "$BUILD" && /usr/bin/shasum -a 256 "${files[@]}" | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}')
}

# ---------------------------------------------------------------------------
# Automatic image updates
# ---------------------------------------------------------------------------
debian_updates_pending() {   # prints count, or fails if the check could not run
  container run --rm --user 0 "$IMAGE" /bin/sh -c \
    'apt-get update -qq >/dev/null 2>&1 || exit 2; apt list --upgradable 2>/dev/null | grep -c "upgradable from" || true'
}

ensure_image_current() {
  local force="$1" reason='' hash previous=''
  hash="$(context_hash)"
  [[ -r "$STATE/build.sha256" ]] && previous="$(<"$STATE/build.sha256")"

  if (( force )); then reason='update requested'
  elif ! container image inspect "$IMAGE" >/dev/null 2>&1; then reason='no image yet'
  elif [[ "$previous" != "$hash" ]]; then reason='settings changed'
  elif ! stamp_fresh image-built $(( MAX_IMAGE_AGE_DAYS * 24 )); then reason="image older than $MAX_IMAGE_AGE_DAYS days"
  elif ! stamp_fresh image-checked "$UPDATE_CHECK_HOURS"; then
    info 'Checking Debian for Chromium and system security updates...'
    local n
    if n="$(debian_updates_pending 2>/dev/null)" && [[ "$n" == <-> ]]; then
      stamp image-checked
      (( n > 0 )) && reason="$n Debian package update(s) available (including Chromium if listed)"
    else
      warn 'Could not check Debian for updates (offline?). Using the existing image.'
    fi
  fi

  [[ -z "$reason" ]] && return 0
  info "Rebuilding the browser image: $reason. This takes a few minutes..."
  local cache=(--no-cache)
  [[ "$reason" == 'settings changed' ]] && cache=()
  if ! container build --pull "${cache[@]}" -t "$IMAGE" "$BUILD"; then
    if [[ "$BROWSER" == chrome ]]; then
      warn "Couldn't install Google Chrome (Google's repository unreachable or no ARM64 package)."
      confirm "Build with Debian's Chromium instead this time?" || die 'Image build failed; not launching.'
      BROWSER=chromium
      write_build_context; hash="$(context_hash)"
      container build --pull --no-cache -t "$IMAGE" "$BUILD" || die 'Image build failed; not launching.'
    else
      die 'Image build failed; not launching with a possibly unpatched browser.'
    fi
  fi
  print -r -- "$hash" > "$STATE/build.sha256"
  stamp image-built; stamp image-checked
  info "Image ready: $(container run --rm "$IMAGE" secure-browser-engine --version 2>/dev/null || print "$BROWSER")"
}

ensure_profile_volume() {
  container volume inspect "$PROFILE_VOLUME" >/dev/null 2>&1 && return 0
  info 'Creating persistent browser profile volume...'
  container volume create "$PROFILE_VOLUME" >/dev/null
  container run --rm --user 0 \
    --mount "type=volume,source=$PROFILE_VOLUME,target=/profile" \
    "$IMAGE" /bin/sh -c 'chown -R 1200:1200 /profile'
}

vpn_args() {   # common container args for the VPN (prints one per line)
  (( VPN_ON )) || return 0
  print -l -- --cap-add NET_ADMIN --cap-add MKNOD \
    --mount "type=bind,source=$VPN_DIR,target=/root/secure-browser-vpn,readonly" \
    --dns "$VPN_DNS" -e SECURE_BROWSER_VPN=1
}

# ---------------------------------------------------------------------------
# RESEARCH_MODE=1: pixel streaming
# ---------------------------------------------------------------------------
research_running() { container list --quiet 2>/dev/null | /usr/bin/grep -qx "$RESEARCH_NAME"; }

open_viewer() {   # open_viewer PORT PASSWORD [VIEWER]
  local port="$1" pw="$2" viewer="${3:-$VIEWER}" link plain app
  if [[ "$viewer" == screensharing ]]; then
    link="vnc://:$pw@127.0.0.1:$port"; plain="vnc://127.0.0.1:$port"; app='Screen Sharing'
  else
    # The password goes in the URL fragment (after #), which stays in the browser tab
    # and is never sent to the server; noVNC reads it and logs you in.
    link="http://127.0.0.1:$port/vnc.html#autoconnect=1&reconnect=1&resize=remote&path=websockify&password=$pw"
    plain="http://127.0.0.1:$port"; app='Safari'
  fi

  local opened=0
  if [[ "$viewer" == screensharing ]]; then
    /usr/bin/open "$link" >/dev/null 2>&1 && opened=1
  else
    /usr/bin/open -a Safari "$link" >/dev/null 2>&1 && opened=1
  fi

  if (( opened )); then
    info "Opened $app (logged in automatically)."
    [[ "$viewer" == screensharing ]] && info '  IMPORTANT: in Screen Sharing, turn OFF Edit > Use Shared Clipboard.'
    return 0
  fi

  # No desktop session to open apps in (e.g. over SSH, or a user not logged in on
  # screen). The session is running; show how to open it by hand.
  info ''
  info "Couldn't open $app automatically (no desktop session available to this terminal)."
  info 'The research browser IS running. Open it in a browser on this Mac:'
  info ''
  if [[ "$viewer" == screensharing ]]; then
    info "  In Screen Sharing (Finder > Go > Connect to Server), connect to:  $plain"
    info "  Password:  $pw"
    info '  Then turn OFF Edit > Use Shared Clipboard.'
  else
    info '  Easiest: paste this whole link into Safari (logs you in automatically):'
    info "    $link"
    info ''
    info "  Or go to  $plain  and type the password:  $pw"
  fi
  info ''
  info "  Later, from a terminal in your desktop session:  $SELF --open"
}

launch_research() {
  local port pw args=() i
  port="$(view_port)"
  if research_running; then
    if running_is_current research && [[ -r "$STATE/session.pw" ]]; then
      info 'Research browser already running and up to date; reopening the viewer.'
      reopen_running_viewer
      return 0
    fi
    info 'The running research browser was started with an older image or settings.'
    if confirm 'Restart it now with the updated version? (closes its tabs)'; then
      container stop "$RESEARCH_NAME" >/dev/null 2>&1 || true
      for i in {1..40}; do
        container inspect "$RESEARCH_NAME" >/dev/null 2>&1 || break   # --rm removes it
        sleep 0.5
      done
      container inspect "$RESEARCH_NAME" >/dev/null 2>&1 && die "Old research container still exists; run: container delete $RESEARCH_NAME"
    else
      [[ -r "$STATE/session.pw" ]] || die "Its viewer password is missing; run $SELF --stop and relaunch."
      warn 'Keeping the old session; reopening its viewer. Updates apply the next time it starts.'
      reopen_running_viewer
      return 0
    fi
  fi
  # A stopped container with our name (e.g. after a crash) would block the new one.
  if container inspect "$RESEARCH_NAME" >/dev/null 2>&1; then
    container delete "$RESEARCH_NAME" >/dev/null 2>&1 || die "Remove the old container first: container delete $RESEARCH_NAME"
  fi
  /usr/sbin/lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1 &&
    die "Port $port on this Mac is already in use; free it or change VIEW_PORT_* in the script."

  pw="$(/usr/bin/openssl rand -base64 24 | /usr/bin/tr -dc 'A-Za-z0-9' | /usr/bin/cut -c1-8)"
  [[ ${#pw} -eq 8 ]] || die 'Could not generate a session password.'
  mkdir -p "$STATE"; print -r -- "$pw" > "$STATE/session.pw"; chmod 600 "$STATE/session.pw"

  local cport=6080
  [[ "$VIEWER" == screensharing ]] && cport=5901
  args=(run -d --rm --init --name "$RESEARCH_NAME" --user 0
        --memory 4G --cpus 4 --shm-size 1G
        -p "127.0.0.1:$port:$cport"
        --read-only --tmpfs /tmp --tmpfs /run --tmpfs /var/tmp --tmpfs /var/lib/xkb --tmpfs /home/browser
        -e SECURE_BROWSER_DISPLAY=vnc -e "SECURE_BROWSER_VIEWER=$VIEWER"
        -e "SECURE_BROWSER_PUBLISHED_PORT=$cport" -e "VNC_PASSWORD=$pw"
        ${(f)"$(vpn_args)"})
  args+=("$IMAGE" /usr/local/bin/secure-chromium)

  info 'Starting the research browser VM...'
  if [[ ! -e "$STATE/local-network-explained" ]]; then
    info '  macOS may ask: Allow "container-runtime-linux" to find devices on local networks?'
    info '  Choose ALLOW. It is Apple Container relaying the viewer from 127.0.0.1 into the VM.'
    info '  Your home network stays blocked by the kill switch inside the VM either way.'
    : > "$STATE/local-network-explained"
  fi
  container "${args[@]}" >/dev/null || die 'Apple Container refused to start the research browser.'
  local reachable=0
  for i in {1..120}; do
    research_running || break
    if [[ "$VIEWER" == safari ]]; then
      /usr/bin/curl -fsS --max-time 2 -o /dev/null "http://127.0.0.1:$port/vnc.html" 2>/dev/null && { reachable=1; break; }
    else
      /usr/bin/nc -z 127.0.0.1 "$port" 2>/dev/null && { reachable=1; break; }
    fi
    sleep 0.5
  done
  if research_running && (( ! reachable )); then
    warn "The browser VM is running but the viewer at 127.0.0.1:$port isn't answering."
    info '  If you chose "Don'"'"'t Allow" on the local-network prompt, turn it on in System Settings >'
    info '  Privacy & Security > Local Network (container-runtime-linux), then run this again.'
  fi
  if ! research_running; then
    container logs "$RESEARCH_NAME" 2>/dev/null | /usr/bin/tail -n 40 || true
    (( VPN_ON )) && info 'If the log mentions secure-browser-vpn, the tunnel failed and the kill switch kept the browser offline.'
    die 'The research browser stopped during startup.'
  fi
  sleep 1
  session_fingerprint > "$STATE/running-research"
  print -r -- "$VIEWER $port" > "$STATE/running-viewer"
  open_viewer "$port" "$pw"
}

reopen_running_viewer() {   # use the viewer and port the running session was started with
  local v p
  read -r v p < "$STATE/running-viewer" 2>/dev/null || { v="$VIEWER"; p="$(view_port)"; }
  open_viewer "$p" "$(<"$STATE/session.pw")" "$v"
}

# ---------------------------------------------------------------------------
# RESEARCH_MODE=0: Cocoa-Way native window
# ---------------------------------------------------------------------------
session_running() {
  local json
  command -v cocoa-wayctl >/dev/null 2>&1 || return 1
  cocoa-wayctl --json status >/dev/null 2>&1 || return 1
  json="$(cocoa-wayctl --json applications 2>/dev/null || true)"
  print -r -- "$json" | /usr/bin/grep -q "\"name\":\"$SESSION\".*\"state\":\"Running\""
}

stop_all() {
  if research_running; then
    info 'Stopping the research browser...'
    container stop "$RESEARCH_NAME" >/dev/null 2>&1 || true
  fi
  rm -f "$STATE/session.pw" "$STATE/running-research" "$STATE/running-viewer"
  session_running || return 0
  info "Stopping $SESSION..."
  cocoa-wayctl stop "$SESSION" >/dev/null 2>&1 || true
  local i
  for i in {1..60}; do session_running || { rm -f "$STATE/running-cocoa"; return 0; }; sleep 0.25; done
  die "$SESSION did not stop; close it manually and retry."
}

cocoa_config_without_session() {   # prints Cocoa-Way config minus our session entry
  [[ -r "$CW_CONFIG" ]] || return 0
  /usr/bin/awk -v want="\"$SESSION\"" '
    function emit() { if (!in_s || !target) printf "%s", block }
    /^[[:space:]]*\[\[session\]\][[:space:]]*$/ { emit(); block=$0 ORS; in_s=1; target=0; next }
    { if (in_s && $0 ~ /^[[:space:]]*name[[:space:]]*=/ && index($0, want)) target=1; block=block $0 ORS }
    END { emit() }' "$CW_CONFIG" |
  /usr/bin/awk 'NF { if (seen) printf "%s", blanks; print; seen=1; blanks=""; next } { if (seen) blanks=blanks $0 ORS }'
}

# Research mode: the old Cocoa-Way browser must not keep running unnoticed, and
# its app-list entry must not be able to start the new image without the VPN.
retire_cocoa_session() {
  if session_running; then
    info ''
    info "The older '$SESSION' browser (Cocoa-Way window) is still running."
    info '  It does NOT have research-mode protections (and may have no VPN).'
    if confirm 'Stop it now? (recommended)'; then
      cocoa-wayctl stop "$SESSION" >/dev/null 2>&1 || true
      local i; for i in {1..60}; do session_running || break; sleep 0.25; done
      session_running && warn "Could not stop '$SESSION'; close its windows yourself."
    else
      warn "Leaving '$SESSION' running. Do not use that window for untrusted sites."
    fi
  fi
  if [[ -r "$CW_CONFIG" ]] && /usr/bin/grep -Fq "name = \"$SESSION\"" "$CW_CONFIG"; then
    local work; work="$(mktemp "${TMPDIR:-/tmp}/secure-browser-cocoa.XXXXXX")"
    cocoa_config_without_session > "$work"
    /bin/cp -f "$CW_CONFIG" "$STATE/container-sessions.toml.bak"
    chmod 600 "$work"; mv -f "$work" "$CW_CONFIG"
    info "Removed the old '$SESSION' entry from Cocoa-Way's app list so it can't start the new image"
    info "  without the VPN setup (backup: $STATE/container-sessions.toml.bak). RESEARCH_MODE=0 recreates it."
  fi
}

# What a running session was started with; a mismatch means it is out of date.
session_fingerprint() {
  local h='' b=''
  [[ -r "$STATE/build.sha256" ]] && h="$(<"$STATE/build.sha256")"
  [[ -r "$STATE/image-built" ]] && b="$(<"$STATE/image-built")"
  print -r -- "$h|$b|vpn=$VPN_ON|viewer=$VIEWER|persist=$(profile_persistent && print 1 || print 0)|dl=$ENABLE_DOWNLOADS|audio=$(audio_on && print 1 || print 0)"
}
running_is_current() {   # running_is_current research|cocoa
  [[ -r "$STATE/running-$1" && "$(<"$STATE/running-$1")" == "$(session_fingerprint)" ]]
}

CONFIG_CHANGED=0
write_cocoa_config() {
  local work rargs=() a joined=''
  mkdir -p "${CW_CONFIG:h}"
  work="$(mktemp "${TMPDIR:-/tmp}/secure-browser-cocoa.XXXXXX")"
  rargs=(--user 0 --memory 4G --cpus 4 --shm-size 1G)
  if profile_persistent; then
    rargs+=(--mount "type=volume,source=$PROFILE_VOLUME,target=/home/browser/.config/chromium"
            -e SECURE_BROWSER_PERSIST=1)
  else
    rargs+=(--tmpfs /home/browser/.config/chromium)
  fi
  (( ENABLE_DOWNLOADS )) && rargs+=(--mount "type=bind,source=$DOWNLOADS,target=/home/browser/Downloads")
  rargs+=(${(f)"$(vpn_args)"})
  audio_on && rargs+=(-e SECURE_BROWSER_AUDIO=1)
  for a in "${rargs[@]}"; do joined+="\"$a\", "; done
  joined="${joined%, }"

  cocoa_config_without_session > "$work"
  [[ -s "$work" ]] && print >> "$work"
  cat >> "$work" <<EOF_CONFIG
[[session]]
name = "$SESSION"
runtime = "container"
image = "$IMAGE"
profile = "single-app"
presentation = "rootless"
display = "auto"
audio = $( audio_on && print true || print false )
command = "/usr/local/bin/secure-chromium"
runtime_args = [$joined]
EOF_CONFIG
  if [[ -r "$CW_CONFIG" ]] && /usr/bin/cmp -s "$work" "$CW_CONFIG"; then
    rm -f "$work"; CONFIG_CHANGED=0
  else
    chmod 600 "$work"; mv -f "$work" "$CW_CONFIG"; CONFIG_CHANGED=1
  fi
}

start_cocoa_way() {
  if cocoa-wayctl --json status >/dev/null 2>&1; then
    (( CONFIG_CHANGED )) || return 0
    info 'Cocoa-Way must restart to load the new settings (this closes other Cocoa-Way apps).'
    confirm 'Restart Cocoa-Way now?' || die 'Settings saved; restart Cocoa-Way yourself and rerun.'
    /usr/bin/killall cocoa-way 2>/dev/null || true
    sleep 1
  fi
  info 'Starting Cocoa-Way...'
  cocoa-way >"$CW_LOG" 2>&1 &!
  local i
  for i in {1..80}; do cocoa-wayctl --json status >/dev/null 2>&1 && return 0; sleep 0.25; done
  cat "$CW_LOG" >&2 || true
  die 'Cocoa-Way did not start.'
}

launch_cocoa() {
  if session_running; then
    if running_is_current cocoa; then
      info "$SESSION is already running and up to date. Use Command-N for a new window."
      return 0
    fi
    info "The running '$SESSION' was started with an older image or settings."
    if confirm 'Restart it now with the updated version? (closes its windows)'; then
      cocoa-wayctl stop "$SESSION" >/dev/null 2>&1 || true
      local j; for j in {1..60}; do session_running || break; sleep 0.25; done
      session_running && die "Could not stop '$SESSION'; close it and rerun."
    else
      warn 'Keeping the old session. Updates apply the next time it starts.'
      return 0
    fi
  fi
  profile_persistent && ensure_profile_volume
  write_cocoa_config
  start_cocoa_way
  info 'Launching Secure Chromium...'
  cocoa-wayctl launch "$SESSION" || die 'Launch request failed.'
  local i ok=0
  for i in {1..80}; do session_running && { ok=1; break; }; sleep 0.25; done
  if (( ! ok )); then
    cocoa-wayctl --json logs "$SESSION" 2>/dev/null || true
    die 'Secure Chromium did not stay running.'
  fi
  session_fingerprint > "$STATE/running-cocoa"
}

# ---------------------------------------------------------------------------
# --test
# ---------------------------------------------------------------------------
self_test() {
  local fails=0
  container system status >/dev/null 2>&1 || die 'Apple Container is not running; launch the browser once first.'
  container image inspect "$IMAGE" >/dev/null 2>&1 || die 'Image missing; launch the browser once first.'

  info 'Test 1: image contents.'
  if container run --rm "$IMAGE" /bin/sh -ec '
      test "$(id -u)" = 1200
      command -v secure-browser-engine >/dev/null && command -v setpriv >/dev/null && command -v wg >/dev/null
      command -v Xtigervnc >/dev/null && command -v websockify >/dev/null
      test -f /usr/share/novnc/vnc.html
      test -u /opt/google/chrome/chrome-sandbox || test -u /usr/lib/chromium/chrome-sandbox
      test -r /etc/opt/chrome/policies/managed/secure-browser.json
      test -r /etc/chromium/policies/managed/secure-browser.json
      secure-browser-engine --version'; then info '  PASS'; else info '  FAIL'; fails=$((fails+1)); fi

  info 'Test 2: image policy matches these settings (JIT, clipboard, downloads).'
  local g h
  g="$(container run --rm "$IMAGE" sha256sum /etc/opt/chrome/policies/managed/secure-browser.json 2>/dev/null | /usr/bin/awk '{print $1}' || true)"
  h="$(/usr/bin/shasum -a 256 "$BUILD/secure-browser-policy.json" 2>/dev/null | /usr/bin/awk '{print $1}' || true)"
  if [[ -n "$h" && "$g" == "$h" ]]; then info '  PASS'; else info '  FAIL (run the launcher to rebuild)'; fails=$((fails+1)); fi

  prepare_vpn
  if (( VPN_ON )); then
    info 'Test 3: tunnel, exit IP, hidden key, LAN/Mac blocked, viewer return path, kill switch.'
    local out host_ip exit_ip r pubenv=()
    (( RESEARCH_MODE )) && pubenv=(-e "SECURE_BROWSER_PUBLISHED_PORT=$([[ $VIEWER == safari ]] && print 6080 || print 5901)")
    out="$(container run --rm --user 0 ${(f)"$(vpn_args)"} "${pubenv[@]}" \
            "$IMAGE" /usr/local/sbin/secure-browser-vpn-selftest 2>&1 || true)"
    print -r -- "$out" | /usr/bin/grep -v '^RESULT' || true
    host_ip="$(/usr/bin/curl -fsS --max-time 10 https://api.ipify.org 2>/dev/null || true)"
    exit_ip="$(print -r -- "$out" | /usr/bin/awk '$2=="exit_ip"{print $3}')"
    local checks=(vpn_up key_hidden lan_and_mac_routed_into_tunnel kill_switch)
    (( RESEARCH_MODE )) && checks+=(viewer_return_path_only)
    for r in "${checks[@]}"; do
      if print -r -- "$out" | /usr/bin/grep -q "^RESULT $r PASS"; then info "  PASS $r"
      else info "  FAIL $r"; fails=$((fails+1)); fi
    done
    if [[ -n "$exit_ip" && "$exit_ip" != NONE && "$exit_ip" != "$host_ip" ]]; then
      info "  PASS exit IP $exit_ip differs from this Mac's IP ${host_ip:-unknown}"
    else
      info "  FAIL exit IP '${exit_ip:-none}' (Mac: ${host_ip:-unknown})"; fails=$((fails+1))
    fi
  else
    info 'Test 3: VPN off; tunnel tests skipped.'
  fi

  if (( RESEARCH_MODE )); then
    info "Test 4: viewer port is bound to this Mac only (127.0.0.1)."
    if research_running; then
      local p; p="$(view_port)"
      if /usr/sbin/lsof -nP -iTCP:"$p" -sTCP:LISTEN 2>/dev/null | /usr/bin/awk 'NR>1{print $9}' | /usr/bin/grep -vq '^127\.0\.0\.1:'; then
        info '  FAIL viewer port is reachable from other machines'; fails=$((fails+1))
      else info '  PASS'; fi
    else
      info '  SKIPPED (start the research browser first)'
    fi
  fi

  info 'Manual checks in the research browser: chrome://policy (no errors), chrome://sandbox (green),'
  info '  a DNS/WebRTC leak test page, and copy/paste between Mac and browser should NOT work.'
  (( fails == 0 )) || die "$fails test(s) failed."
  info 'All automated tests passed.'
}

# ---------------------------------------------------------------------------
# --uninstall: remove what this script created, from least to most. Each level
# includes the ones before it. Never touches Apple Container itself, Homebrew
# packages, the shared Debian base image, or your Downloads folder.
uninstall() {
  [[ -t 0 ]] || die '--uninstall is interactive; run it from a terminal.'
  [[ -n "$HOME" && "$BASE" == "$HOME/.secure-browser-wayland" ]] || die 'Unexpected data folder; refusing to delete.'
  local have_container=0; command -v container >/dev/null 2>&1 && have_container=1
  info 'What do you want to remove? Each level includes the ones before it.'
  info ''
  info '  1  Session only        Stop the browser and delete its VM and the session state.'
  info '                         Keeps the image, so the next launch is fast.'
  info '  2  + Browser image     Also delete the built browser image, the build folder and'
  info '                         stop the image builder. The next launch rebuilds (minutes).'
  info '  3  + Data              Also delete the persistent profile volume (mode 0), the'
  info "                         Cocoa-Way app-list entry, and the whole $BASE"
  info '                         folder (update times, working VPN copy, logs).'
  info '  4  + Everything        Also delete your saved WireGuard config'
  info "                         ($WIREGUARD_CONF) and this script itself."
  info ''
  info '  Never removed: Apple Container, Homebrew packages, the Debian base image'
  info "  (debian:trixie-slim), and $DOWNLOADS."
  info ''
  local level
  printf 'Level [1-4, or q to quit]: '
  IFS= read -r level || return 0
  [[ "$level" == [1-4] ]] || { info 'Nothing removed.'; return 0; }

  info ''
  info "This will remove (level $level):"
  info '  - the running browser session and its VM'
  (( level >= 2 )) && info "  - the image $IMAGE, the build folder $BUILD, and the image builder"
  if (( level >= 3 )); then
    info "  - the persistent profile volume $PROFILE_VOLUME (extensions, logins, settings)"
    info "  - the '$SESSION' entry in $CW_CONFIG (if present)"
    info "  - the folder $BASE"
  fi
  if (( level >= 4 )); then
    info "  - $WIREGUARD_CONF (your VPN credential)"
    info "  - this script: $SELF_PATH"
  fi
  confirm 'Continue?' || { info 'Nothing removed.'; return 0; }
  info ''

  # Level 1: stop the session
  (( have_container )) && stop_all || rm -f "$STATE/session.pw" "$STATE/running-research" "$STATE/running-viewer"
  if (( have_container )); then
    container delete "$RESEARCH_NAME" >/dev/null 2>&1 && info "Deleted container $RESEARCH_NAME."
  fi

  # Level 2: image, build folder, builder
  if (( level >= 2 )); then
    if (( have_container )); then
      container image delete "$IMAGE" >/dev/null 2>&1 && info "Deleted image $IMAGE." || info "Image $IMAGE not present (or in use)."
      container stop buildkit >/dev/null 2>&1 && info 'Stopped the image builder.'
    fi
    [[ -d "$BUILD" && ! -L "$BUILD" ]] && { rm -rf -- "$BUILD"; info "Deleted $BUILD."; }
  fi

  # Level 3: data
  if (( level >= 3 )); then
    if (( have_container )) && container volume inspect "$PROFILE_VOLUME" >/dev/null 2>&1; then
      container volume delete "$PROFILE_VOLUME" >/dev/null 2>&1 && info "Deleted volume $PROFILE_VOLUME." ||
        warn "Could not delete volume $PROFILE_VOLUME; run: container volume delete $PROFILE_VOLUME"
    fi
    if [[ -r "$CW_CONFIG" ]] && /usr/bin/grep -Fq "name = \"$SESSION\"" "$CW_CONFIG"; then
      local work; work="$(mktemp "${TMPDIR:-/tmp}/secure-browser-cocoa.XXXXXX")"
      cocoa_config_without_session > "$work"; chmod 600 "$work"; mv -f "$work" "$CW_CONFIG"
      info "Removed the '$SESSION' entry from Cocoa-Way's app list."
    fi
    if [[ -d "$BASE" && ! -L "$BASE" ]]; then rm -rf -- "$BASE"; info "Deleted $BASE."; fi
  fi

  # Level 4: credential and the script
  if (( level >= 4 )); then
    if [[ -f "$WIREGUARD_CONF" ]]; then
      rm -f -- "$WIREGUARD_CONF"; rmdir "${WIREGUARD_CONF:h}" 2>/dev/null || true
      info "Deleted $WIREGUARD_CONF."
      info '  If you are done with that VPN account, also revoke the config in your provider'"'"'s dashboard.'
    fi
  fi

  info ''
  info 'Done. Left in place:'
  info '  - Apple Container (system-wide; remove it with Apple'"'"'s uninstall script from github.com/apple/container)'
  info '  - the Debian base image: container image delete debian:trixie-slim  (only if nothing else uses it)'
  [[ -d "$DOWNLOADS" ]] && info "  - your downloads folder: $DOWNLOADS"
  info '  - Safari history entries for 127.0.0.1 (clear them in Safari)'
  if (( level >= 4 )); then
    rm -f -- "$SELF_PATH" && info "Deleted this script ($SELF_PATH)."
  else
    info "  - this script ($SELF); run $SELF --uninstall again and pick level 4 to remove it"
  fi
}

main() {
  case "$MODE" in
    check)
      local t missing=0 tools=(container)
      (( RESEARCH_MODE )) || tools+=(cocoa-way cocoa-wayctl waypipe)
      for t in "${tools[@]}"; do
        if command -v "$t" >/dev/null 2>&1; then info "OK: $t"; else info "MISSING: $t"; missing=1; fi
      done
      [[ -r "$WIREGUARD_CONF" ]] && info "OK: WireGuard config $WIREGUARD_CONF" ||
        info "NO WireGuard config at $WIREGUARD_CONF (needed for VPN=1)"
      return $missing ;;
    stop) stop_all; return 0 ;;
    uninstall) uninstall; return 0 ;;
    test) self_test; return 0 ;;
    import) import_vpn; return 0 ;;
    open)
      # Reopen the viewer for the running session, already logged in. No checks, no rebuild.
      if research_running && [[ -r "$STATE/session.pw" ]]; then
        reopen_running_viewer; return 0
      fi
      info 'No research session is running; starting one.'
      MODE=launch ;;
    reset)
      stop_all
      container volume inspect "$PROFILE_VOLUME" >/dev/null 2>&1 || { info 'No persistent profile to delete.'; return 0; }
      info "This deletes the persistent profile volume '$PROFILE_VOLUME' (extensions, logins, settings)."
      confirm 'Delete it?' || return 0
      container volume delete "$PROFILE_VOLUME"
      info 'Persistent profile deleted.'; return 0 ;;
  esac

  ensure_host_prerequisites
  [[ ! -L "$BASE" && ! -L "$BUILD" && ! -L "$DOWNLOADS" && ! -L "$CW_CONFIG" ]] || die 'Refusing symlinked paths.'
  case "$HOME" in *'"'*|*'\'*|*','*|*$'\n'*) die 'Your home folder path has characters this script cannot pass safely.' ;; esac
  mkdir -p "$BASE" "$STATE"; chmod 700 "$BASE" "$STATE"
  if (( ENABLE_DOWNLOADS )) && [[ ! -d "$DOWNLOADS" ]]; then mkdir -p "$DOWNLOADS"; chmod 700 "$DOWNLOADS"; fi

  local force=0
  [[ "$MODE" == update ]] && { force=1; stop_all; }

  container system status >/dev/null 2>&1 || {
    info 'Starting Apple Container...'
    container system start || die 'Apple Container did not start (try: container system kernel set --recommended).'
  }
  run_security_checks "$force"

  prepare_vpn
  if (( VPN_ON && INSTALL_PROTON_EXTENSION )); then
    info 'Note: WireGuard is on, so the Proton extension is not needed. Set INSTALL_PROTON_EXTENSION=0'
    info '  to use a throwaway profile with no stored login.'
  fi
  write_build_context
  ensure_image_current "$force"   # rebuilds now if needed; a running session keeps its old copy

  if (( RESEARCH_MODE )); then
    retire_cocoa_session
    launch_research
  else
    launch_cocoa
  fi

  local vpn_line
  if (( VPN_ON )); then vpn_line='VPN on, with kill switch (no internet if the VPN drops; home network blocked)'
  elif (( VPN )); then vpn_line='VPN OFF for this session (no config found), so sites see your real IP'
  else vpn_line='VPN off (VPN=0 in settings), so sites see your real IP'; fi

  info ''
  if (( RESEARCH_MODE )); then
    info "Your research browser is open in ${${VIEWER:#safari}:+Screen Sharing}${${VIEWER:#screensharing}:+Safari}."
    info ''
    info "  Network:     $vpn_line"
    info '  Isolation:   no copy/paste and no downloads between the browser and your Mac'
    info '  Fresh start: nothing is kept; each session starts clean'
    info '  Hardening:   extra exploit protection (JavaScript JIT turned off)'
    info ''
    if [[ -r "$STATE/session.pw" && -r "$STATE/running-viewer" ]]; then
      local rv rp; read -r rv rp < "$STATE/running-viewer"
      if [[ "$rv" == screensharing ]]; then
        info "  Address:     vnc://127.0.0.1:$rp    Password: $(<"$STATE/session.pw")"
      else
        info "  Address:     http://127.0.0.1:$rp    Password: $(<"$STATE/session.pw")"
      fi
    fi
    info '  Shortcuts:   use Ctrl instead of Command (Ctrl-T new tab, Ctrl-L address bar)'
    info "  Reopen:      $SELF --open   (logs you in; no need to type the password)"
    info "  To finish:   close the browser window, or run  $SELF --stop"
  else
    info 'Your browser is open in its own window (convenience mode).'
    info ''
    info "  Network:     $vpn_line"
    info '  Clipboard:   copy/paste with your Mac is ON. Don'"'"'t copy passwords while it runs.'
    info "  To finish:   close the browser, or run  $SELF --stop"
  fi
  info ''
  info "  Check setup: $SELF --test        Update now: $SELF --update"
}

main
