# Secure Chromium in an Apple Container VM.
#
# RESEARCH_MODE=1 (default): for exploring untrusted sites. The browser is
#   shown as a pixel stream in Safari (noVNC) or macOS Screen Sharing. No
#   clipboard sharing, no downloads, no persistence, JIT off, read-only system.
#   Needs only Apple Container on the Mac.
# RESEARCH_MODE=0: convenience mode. The browser appears as a native macOS
#   window through Cocoa-Way (clipboard, downloads and audio available).
#
# VPN=1 (default): all traffic goes through WireGuard with a kill switch. If
# the tunnel fails, the browser does not start.
#
# Usage: ~/secure-browser [--open | --update | --check | --test | --stop | --reset-profile | --import-vpn | --uninstall]

# ============================================================================
# USER OPTIONS
# ============================================================================
RESEARCH_MODE=1
#   1 = hardened pixel-streaming mode (overrides the convenience options below)
#   0 = Cocoa-Way native window, with the convenience options below

VIEWER=safari
#   safari        = noVNC web viewer in Safari (recommended: Apple-patched, sandboxed)
#   screensharing = macOS Screen Sharing. Turn OFF Edit > Use Shared Clipboard
#                   in Screen Sharing every session.

BROWSER=chrome
#   chrome   = Google's official Chrome for ARM64 Linux, from Google's signed apt
#              repository (same-day security fixes; recommended)
#   chromium = Debian's Chromium build (open source; fixes can trail by days)
#   If Chrome can't be installed, you're asked whether to fall back to Chromium.

VPN=1
#   1 = all browser traffic through WireGuard, kill switch, home network blocked
#   0 = normal network
WIREGUARD_CONF="$HOME/.config/secure-browser/wireguard.conf"

# Automatic updates and security checks
UPDATE_CHECK_HOURS=6        # How often to check Debian / Apple Container / Cocoa-Way
MAX_IMAGE_AGE_DAYS=7        # Rebuild even without detected updates after this long

# --- Convenience options: only used when RESEARCH_MODE=0 ---------------------
PERSIST_PROFILE=auto        # auto = keep the profile ONLY when INSTALL_PROTON_EXTENSION=1
                            #        (so its login survives); otherwise throwaway.
                            # 1 = always keep (bookmarks, extensions); 0 = always throwaway
INSTALL_PROTON_EXTENSION=0  # force-install Proton's browser extension
ENABLE_DOWNLOADS=1          # downloads to ~/Downloads/secure-browser
ALLOW_SITE_CLIPBOARD_API=1  # websites may request clipboard permission
ENABLE_AUDIO=1              # needs cocoa-way-audio-relay in the build folder
# ============================================================================

set -euo pipefail
umask 077
SELF="${0:A}"                                         # how to refer to this script in messages
SELF_PATH="$SELF"                                     # real path, used by --uninstall
[[ "$SELF" == "$HOME/"* ]] && SELF="~/${SELF#$HOME/}"

IMAGE="localhost/secure-browser-hardened:latest"
SESSION="Secure Chromium"                 # Cocoa-Way session name (mode 0)
RESEARCH_NAME="secure-browser-research"   # container name (mode 1)
PROFILE_VOLUME="secure-browser-profile"
PROTON_ID="jplgfhpmjnbigmhklmmbgecoobifkmpa"
VIEW_PORT_SAFARI=6080
VIEW_PORT_SCREENSHARING=5901

BASE="$HOME/.secure-browser-wayland"
BUILD="$BASE/hardened-build"
VPN_DIR="$BASE/vpn"
STATE="$BASE/state"
DOWNLOADS="$HOME/Downloads/secure-browser"
CW_CONFIG="$HOME/.config/cocoa-way/container-sessions.toml"
CW_LOG="$BASE/cocoa-way.log"
AUDIO_RELAY="$BUILD/cocoa-way-audio-relay"

MODE=launch
case "${1:-}" in
  "") ;;
  --update) MODE=update ;;
  --check) MODE=check ;;
  --test) MODE=test ;;
  --stop) MODE=stop ;;
  --reset-profile) MODE=reset ;;
  --import-vpn) MODE=import ;;
  --open) MODE=open ;;
  --uninstall) MODE=uninstall ;;
  *) print -u2 "Usage: $SELF [--open | --update | --check | --test | --stop | --reset-profile | --import-vpn | --uninstall]"; exit 2 ;;
esac
(( $# <= 1 )) || { print -u2 'Only one option at a time.'; exit 2; }
for flag in RESEARCH_MODE VPN INSTALL_PROTON_EXTENSION ENABLE_DOWNLOADS ALLOW_SITE_CLIPBOARD_API ENABLE_AUDIO; do
  [[ "${(P)flag}" == [01] ]] || { print -u2 "ERROR: $flag must be 0 or 1"; exit 2; }
done
[[ "$BROWSER" == (chrome|chromium) ]] || { print -u2 'ERROR: BROWSER must be chrome or chromium'; exit 2; }
[[ "$VIEWER" == (safari|screensharing) ]] || { print -u2 'ERROR: VIEWER must be safari or screensharing'; exit 2; }
[[ "$PERSIST_PROFILE" == (auto|0|1) ]] || { print -u2 'ERROR: PERSIST_PROFILE must be auto, 0 or 1'; exit 2; }
[[ "$MAX_IMAGE_AGE_DAYS" == <-> && "$UPDATE_CHECK_HOURS" == <-> ]] || { print -u2 'ERROR: ages must be numbers'; exit 2; }

# Research mode overrides every convenience switch.
if (( RESEARCH_MODE )); then
  PERSIST_PROFILE=0; INSTALL_PROTON_EXTENSION=0; ENABLE_DOWNLOADS=0
  ALLOW_SITE_CLIPBOARD_API=0; ENABLE_AUDIO=0
fi

info() { print -r -- "$*"; }
warn() { print -r -- "WARNING: $*"; }
die()  { print -ru2 -- "ERROR: $*"; exit 1; }

confirm() {
  local answer
  [[ -t 0 ]] || { info "(non-interactive: answering no to: $1)"; return 1; }
  printf '%s [y/N] ' "$1"
  IFS= read -r answer || return 1
  [[ "$answer" == ([Yy]|[Yy][Ee][Ss]) ]]
}

ver_lt() {   # ver_lt A B: true if version A < version B
  /usr/bin/awk -v a="$1" -v b="$2" 'BEGIN {
    na = split(a, x, "."); nb = split(b, y, "."); n = (na > nb ? na : nb)
    for (i = 1; i <= n; i++) { if ((x[i]+0) < (y[i]+0)) exit 0; if ((x[i]+0) > (y[i]+0)) exit 1 }
    exit 1 }'
}
first_semver() { /usr/bin/grep -Eo '[0-9]+\.[0-9]+(\.[0-9]+)?' | /usr/bin/head -n1 || true; }

stamp_fresh() {   # stamp_fresh NAME HOURS: true if NAME was touched less than HOURS ago
  local f="$STATE/$1" t=0
  [[ -r "$f" ]] && t="$(<"$f")"
  [[ "$t" == <-> ]] || t=0
  (( $(/bin/date +%s) - t < $2 * 3600 ))
}
stamp() { mkdir -p "$STATE"; /bin/date +%s > "$STATE/$1"; }

# ---------------------------------------------------------------------------
# Host dependencies
# ---------------------------------------------------------------------------
# Homebrew is optional everywhere. It is used only if already installed, and
# only for Cocoa-Way (RESEARCH_MODE=0). Research mode never needs it.
have_brew() {
  command -v brew >/dev/null 2>&1 && return 0
  [[ -x /opt/homebrew/bin/brew ]] && { eval "$(/opt/homebrew/bin/brew shellenv)"; return 0; }
  return 1
}
cocoa_from_brew() { have_brew && brew list --formula cocoa-way >/dev/null 2>&1; }

PKG_CONTAINER=/usr/local/bin/container   # where Apple's signed installer puts the CLI
REPLACE_BREW_APPROVED=0

# A second 'container' command earlier in PATH (usually Homebrew's) would keep
# running the old version, including the background services it starts, so an
# update would appear to do nothing. Detect it and fix it.
fix_container_path() {
  rehash
  local all=() b first brew_owned=''
  all=(${(u)${(f)"$(whence -ap container 2>/dev/null)"}})   # (u): PATH may list a folder twice
  (( ${#all} )) || return 0
  first="${all[1]}"
  [[ -x "$PKG_CONTAINER" ]] || return 0
  [[ "$first" -ef "$PKG_CONTAINER" ]] && return 0
  info ''
  info "More than one Apple Container 'container' command was found:"
  for b in "${all[@]}"; do info "  $b  (version $("$b" --version 2>/dev/null | first_semver))"; done
  info "  '$first' runs first, so the Apple-installed copy ($PKG_CONTAINER) is being ignored."
  if command -v brew >/dev/null 2>&1 && [[ "$first" == "$(brew --prefix)"/* ]]; then
    if brew list --formula container >/dev/null 2>&1; then brew_owned=formula
    elif brew list --cask container >/dev/null 2>&1; then brew_owned=cask; fi
  fi
  if [[ -n "$brew_owned" ]]; then
    (( REPLACE_BREW_APPROVED )) ||
    confirm "Remove the old Homebrew copy (brew uninstall --$brew_owned container) so Apple's installed one is used? Your images and volumes are kept." ||
      die "Not launching with the old copy first in PATH. Remove '$first' or put /usr/local/bin first in PATH, then rerun."
    info 'Stopping the services the old copy started...'
    container system stop >/dev/null 2>&1 || true
    brew uninstall "--$brew_owned" container
    rehash
    [[ "$(whence -p container)" -ef "$PKG_CONTAINER" ]] || die "Still not using $PKG_CONTAINER; check your PATH."
    info "Now using $PKG_CONTAINER (version $(container --version 2>/dev/null | first_semver))."
    return 0
  fi
  die "Remove or rename '$first', or put /usr/local/bin before its folder in PATH, then rerun."
}

# Installing or updating Apple Container is system-wide and needs sudo. A standard
# (non-admin) account can't do it, so say so up front instead of failing at sudo.
is_admin() { /usr/bin/id -Gn | /usr/bin/grep -qw admin; }
admin_needed_for_container() {   # admin_needed_for_container WHY
  warn "$1"
  info "This account is not an administrator, so it can't install or update Apple Container"
  info '(the installer is system-wide and needs sudo). Ask an admin account to do it, then rerun here:'
  info '  - install the newest signed .pkg from https://github.com/apple/container/releases, or'
  info '  - run:  sudo /usr/local/bin/update-container.sh'
}

ensure_host_prerequisites() {
  [[ "$(uname -s)" == Darwin && "$(uname -m)" == arm64 ]] || die 'Needs macOS on Apple silicon.'
  local major; major="$(/usr/bin/sw_vers -productVersion | /usr/bin/cut -d. -f1)"
  (( major >= 26 )) || die 'Apple Container needs macOS 26 or newer.'
  # Prefer Apple's official signed package everywhere. On first run this
  # installs it if missing, or replaces a Homebrew copy with it (one question).
  rehash
  local cur; cur="$(whence -p container 2>/dev/null || true)"
  if [[ -z "$cur" ]]; then
    info 'Apple Container is not installed.'
    is_admin || { admin_needed_for_container 'Apple Container is required.'; die 'Install Apple Container from an admin account, then rerun.'; }
    confirm "Install it now from Apple's official signed package? (asks for your admin password)" ||
      die 'Apple Container is required. Install it from https://github.com/apple/container/releases and rerun.'
    install_latest_apple_container || die 'Installation failed. Install the .pkg from https://github.com/apple/container/releases and rerun.'
  elif [[ ! -x "$PKG_CONTAINER" ]] && have_brew && [[ "$cur" == "$(brew --prefix)"/* ]]; then
    info "Apple Container is installed through Homebrew ($cur)."
    info "Apple's official signed package is preferred: it is verified by Apple's signature and notarization."
    is_admin || { admin_needed_for_container 'Replacing the Homebrew copy needs an administrator.'; die 'Replace it from an admin account, then rerun.'; }
    confirm "Replace it with Apple's official package now? Your images and volumes are kept. (asks for your admin password)" ||
      die 'Keeping Homebrew Apple Container is not supported by this launcher. Rerun when ready to switch.'
    REPLACE_BREW_APPROVED=1
    install_latest_apple_container || die 'Installation failed; your Homebrew copy is unchanged.'
  fi
  fix_container_path

  (( RESEARCH_MODE )) && return 0   # pixel streaming needs nothing else on the Mac

  local missing=()
  command -v cocoa-way    >/dev/null 2>&1 || missing+=(J-x-Z/tap/cocoa-way)
  command -v cocoa-wayctl >/dev/null 2>&1 || missing+=(J-x-Z/tap/cocoa-way)
  command -v waypipe      >/dev/null 2>&1 || missing+=(J-x-Z/tap/waypipe-darwin)
  if (( ${#missing} )); then
    missing=(${(u)missing})
    if ! have_brew; then
      info 'RESEARCH_MODE=0 needs Cocoa-Way and Waypipe, which are distributed through Homebrew'
      info '(or as source code: https://github.com/J-x-Z/cocoa-way). Homebrew is not installed, and'
      info 'this script will not install it for you.'
      die 'Use RESEARCH_MODE=1 (the default; needs nothing but Apple Container), or install Cocoa-Way yourself.'
    fi
    info 'Cocoa-Way and Waypipe come from the third-party J-x-Z/tap (https://github.com/J-x-Z/cocoa-way).'
    info "Installing by full name trusts only these formulae: ${missing[*]}"
    confirm 'Install them with Homebrew?' || die 'Cocoa-Way is required for RESEARCH_MODE=0.'
    brew install "${missing[@]}"
  fi
  local t
  for t in cocoa-way cocoa-wayctl waypipe; do command -v "$t" >/dev/null 2>&1 || die "Missing $t."; done
}

# ---------------------------------------------------------------------------
# Security update checks (GitHub advisories + release notes)
# ---------------------------------------------------------------------------
gh_api() {   # gh_api PATH -> JSON on stdout, or fails
  /usr/bin/curl -fsS --max-time 15 -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' "https://api.github.com/$1"
}

# Prints one line per security-relevant item newer than INSTALLED:
#   ADVISORY|id|severity|patched-version-or-none
#   RELEASE|tag|security-fix-mentioned(0/1)
security_items() {   # security_items OWNER/REPO INSTALLED
  local adv rel
  adv="$(gh_api "repos/$1/security-advisories?state=published&per_page=100" 2>/dev/null || print '[]')"
  rel="$(gh_api "repos/$1/releases?per_page=30" 2>/dev/null)" || return 1
  /usr/bin/osascript -l JavaScript -e '
    function vlt(a, b) {
      var x = a.split("."), y = b.split(".");
      for (var i = 0; i < Math.max(x.length, y.length); i++) {
        var p = parseInt(x[i] || "0", 10), q = parseInt(y[i] || "0", 10);
        if (p < q) return true; if (p > q) return false;
      }
      return false;
    }
    function ver(s) { var m = String(s || "").match(/[0-9]+\.[0-9]+(\.[0-9]+)?/); return m ? m[0] : ""; }
    function run(a) {
      var inst = a[2], out = [], adv = [], rel = [];
      try { adv = JSON.parse(a[0]); } catch (e) {}
      try { rel = JSON.parse(a[1]); } catch (e) { return "ERROR"; }
      if (!Array.isArray(adv)) adv = [];
      if (!Array.isArray(rel)) return "ERROR";
      adv.forEach(function (x) {
        var vulns = x.vulnerabilities || [];
        if (!vulns.length) vulns = [{}];
        vulns.forEach(function (v) {
          var p = ver(v.patched_versions);
          if (!p || vlt(inst, p))
            out.push(["ADVISORY", x.cve_id || x.ghsa_id || "?", x.severity || "?", p || "none"].join("|"));
        });
      });
      rel.forEach(function (r) {
        if (r.draft || r.prerelease) return;
        var v = ver(r.tag_name);
        if (v && vlt(inst, v)) {
          var sec = /GHSA-[0-9a-z]{4}-|CVE-[0-9]{4}-|security fix|vulnerab/i.test(r.body || "") ? 1 : 0;
          out.push(["RELEASE", v, sec].join("|"));
        }
      });
      return out.join("\n");
    }' "$adv" "$rel" "$2" 2>/dev/null
}

# Download, verify and install the latest signed Apple Container package.
# Verification: GitHub's published SHA-256 for the file (when listed), Apple's
# installer signature (pkgutil) and Gatekeeper notarization (spctl).
install_latest_apple_container() {
  local json meta ver name url digest dir pkg sig signer got
  json="$(gh_api repos/apple/container/releases/latest)" || { warn 'Could not reach GitHub to download the update.'; return 1; }
  meta="$(/usr/bin/osascript -l JavaScript -e '
    function run(a) {
      try {
        var r = JSON.parse(a[0]), assets = r.assets || [];
        var pick = assets.filter(function (x) { return /signed.*\.pkg$/i.test(x.name); })[0] ||
                   assets.filter(function (x) { return /\.pkg$/i.test(x.name); })[0];
        if (!pick) return "";
        var v = (String(r.tag_name).match(/[0-9]+\.[0-9]+(\.[0-9]+)?/) || [""])[0];
        return [v, pick.name, pick.browser_download_url, pick.digest || ""].join("|");
      } catch (e) { return ""; }
    }' "$json" 2>/dev/null || true)"
  IFS='|' read -r ver name url digest <<< "$meta"
  [[ -n "$url" && "$url" == https://github.com/apple/container/releases/download/* ]] ||
    { warn 'No signed installer package found in the latest Apple Container release.'; return 1; }
  [[ "$name" != */* && "$name" == *.pkg ]] || { warn "Unexpected package name '$name'."; return 1; }

  dir="$(mktemp -d "${TMPDIR:-/tmp}/apple-container-update.XXXXXX")"
  pkg="$dir/$name"
  info "Downloading $name (Apple Container $ver)..."
  /usr/bin/curl -fSL --progress-bar --proto '=https' --tlsv1.2 --max-time 600 -o "$pkg" "$url" ||
    { rm -f "$pkg"; rmdir "$dir"; warn 'Download failed.'; return 1; }

  if [[ "$digest" == sha256:* ]]; then
    got="$(/usr/bin/shasum -a 256 "$pkg" | /usr/bin/awk '{print $1}')"
    [[ "sha256:$got" == "$digest" ]] ||
      { rm -f "$pkg"; rmdir "$dir"; warn 'Checksum does not match what GitHub published. Not installing.'; return 1; }
    info '  Checksum matches the release.'
  else
    info '  (GitHub lists no checksum for this file; relying on Apple signature checks.)'
  fi

  sig="$(/usr/sbin/pkgutil --check-signature "$pkg" 2>&1 || true)"
  if ! print -r -- "$sig" | /usr/bin/grep -q 'signed by a developer certificate issued by Apple' ||
     ! /usr/sbin/spctl --assess --type install "$pkg" >/dev/null 2>&1; then
    rm -f "$pkg"; rmdir "$dir"
    warn 'The package is not signed and notarized as expected. Not installing.'
    return 1
  fi
  signer="$(print -r -- "$sig" | /usr/bin/awk '/^ *1\. /{sub(/^ *1\. /,""); print; exit}')"
  info "  Signed and notarized. Signer: ${signer:-unknown}"
  if [[ "$signer" != *"Apple Inc."* ]]; then
    confirm "The signer is not 'Apple Inc.'. Install anyway?" || { rm -f "$pkg"; rmdir "$dir"; return 1; }
  fi

  info 'Stopping Apple Container (running containers stop)...'
  container system stop >/dev/null 2>&1 || true
  info 'Installing. macOS will ask for your admin password:'
  if ! /usr/bin/sudo /usr/sbin/installer -pkg "$pkg" -target /; then
    rm -f "$pkg"; rmdir "$dir"
    container system start >/dev/null 2>&1 || true
    warn 'The installer did not complete.'
    return 1
  fi
  rm -f "$pkg"; rmdir "$dir"
  fix_container_path            # make sure the freshly installed copy is the one that runs
  info 'Starting Apple Container...'
  container system start || { warn 'Apple Container did not start after the update.'; return 1; }
}

check_apple_container() {
  local inst items latest sec_rel adv_lines unfixed
  inst="$(container --version 2>/dev/null | first_semver)"
  [[ -n "$inst" ]] || { warn 'Could not read the Apple Container version.'; return 0; }
  items="$(security_items apple/container "$inst")" || { warn 'Could not check Apple Container updates (offline?).'; return 0; }
  [[ "$items" != ERROR ]] || { warn 'Unexpected GitHub response for Apple Container.'; return 0; }
  latest="$(print -r -- "$items" | /usr/bin/awk -F'|' '$1=="RELEASE"{print $2; exit}')"
  sec_rel="$(print -r -- "$items" | /usr/bin/awk -F'|' '$1=="RELEASE" && $3==1 {print $2}' | /usr/bin/paste -sd, - || true)"
  adv_lines="$(print -r -- "$items" | /usr/bin/awk -F'|' '$1=="ADVISORY" && $4!="none" {print "  " $2 " (" $3 ", fixed in " $4 ")"}')"
  unfixed="$(print -r -- "$items" | /usr/bin/awk -F'|' '$1=="ADVISORY" && $4=="none" {print "  " $2 " (" $3 ", no fix released yet)"}')"
  if [[ -n "$unfixed" ]]; then
    warn 'Apple Container has published advisories with NO fix available yet:'
    info "$unfixed"
    info '  Read them before browsing hostile sites: https://github.com/apple/container/security/advisories'
    confirm 'Continue anyway?' || exit 1
  fi

  if [[ -n "$sec_rel$adv_lines" ]]; then
    info "Apple Container $inst has security fixes available (security releases: ${sec_rel:-see advisories})."
    [[ -n "$adv_lines" ]] && info "$adv_lines"
    info 'The VM boundary depends on Apple Container, so it must be updated before launching.'
    is_admin || { admin_needed_for_container "Apple Container $inst needs a security update."; die 'Not launching with a vulnerable Apple Container. Update it from an admin account, then rerun.'; }
    confirm "Download and install Apple Container ${latest:-latest} now? (stops running containers; asks for your admin password)" ||
      die 'Not launching with a vulnerable Apple Container. Rerun when you are ready to update.'
    if ! install_latest_apple_container; then
      if [[ -x /usr/local/bin/update-container.sh ]] && confirm "Try Apple's own updater script instead?"; then
        container system stop >/dev/null 2>&1 || true
        /usr/local/bin/update-container.sh || true
        container system start || true
      else
        die 'Automatic update failed. Install the latest .pkg from https://github.com/apple/container/releases and rerun.'
      fi
    fi
    rehash
    inst="$(container --version 2>/dev/null | first_semver)"
    if [[ -n "$latest" ]] && ver_lt "${inst:-0}" "$latest"; then
      info "The 'container' command in use is $(whence -p container) (version ${inst:-unknown})."
      [[ -x "$PKG_CONTAINER" ]] && info "Apple's installed copy $PKG_CONTAINER reports $("$PKG_CONTAINER" --version 2>/dev/null | first_semver)."
      die "Apple Container in use is still ${inst:-unknown} (wanted $latest). Not launching."
    fi
    info "Apple Container updated to $inst."
  elif [[ -n "$latest" ]]; then
    info "Apple Container $inst: newer release $latest available (no security fixes listed)."
    if ! is_admin; then
      info '  Not required. To update, ask an admin account to install it (this account has no sudo).'
      return 0
    fi
    confirm "Update to $latest now anyway?" && { install_latest_apple_container || warn 'Update failed; continuing with the current version.'; }
  fi
}

check_cocoa_way() {
  local outdated inst items adv managed=0
  if cocoa_from_brew; then
    managed=1
    outdated="$(brew outdated --quiet J-x-Z/tap/cocoa-way J-x-Z/tap/waypipe-darwin 2>/dev/null || true)"
    if [[ -n "$outdated" ]]; then
      info "Updating the Cocoa-Way bridge (it handles untrusted data on the Mac side): ${(f)outdated}"
      brew upgrade J-x-Z/tap/cocoa-way J-x-Z/tap/waypipe-darwin || die 'Cocoa-Way update failed; use RESEARCH_MODE=1 until it succeeds.'
    fi
    inst="$(brew list --versions cocoa-way 2>/dev/null | first_semver)"
  else
    inst="$(cocoa-way --version 2>/dev/null | first_semver)"
  fi
  [[ -n "$inst" ]] || { warn 'Could not read the Cocoa-Way version; skipping its security check.'; return 0; }
  items="$(security_items J-x-Z/cocoa-way "$inst")" || { warn 'Could not check Cocoa-Way advisories (offline?).'; return 0; }
  adv="$(print -r -- "$items" | /usr/bin/awk -F'|' '($1=="ADVISORY") || ($1=="RELEASE" && $3==1) {print "  " $0}')"
  if [[ -n "$adv" ]]; then
    if (( managed )); then
      info "Cocoa-Way $inst still has unfixed security issues after updating:"
    else
      info "Cocoa-Way $inst (not installed with Homebrew, so it can't be updated automatically) has security fixes pending:"
    fi
    info "$adv"
    die 'Refusing to use the Cocoa-Way bridge. Set RESEARCH_MODE=1 (no Cocoa-Way needed), or update Cocoa-Way and rerun.'
  fi
}

run_security_checks() {
  local force="$1"
  if (( force )) || ! stamp_fresh host-checks "$UPDATE_CHECK_HOURS"; then
    info 'Checking Apple Container for security updates...'
    check_apple_container
    if (( ! RESEARCH_MODE )); then
      info 'Checking the Cocoa-Way bridge for updates and advisories...'
      check_cocoa_way
    fi
    stamp host-checks
  fi
}

# ---------------------------------------------------------------------------
# WireGuard config (host side)
# ---------------------------------------------------------------------------
VPN_ON=0
VPN_DNS=''

conf_values() {   # conf_values KEY FILE -> one value per line
  /usr/bin/awk -v key="$1" '
    { line = $0; sub(/#.*/, "", line) }
    tolower(line) ~ "^[[:space:]]*" tolower(key) "[[:space:]]*=" {
      sub(/^[^=]*=/, "", line); n = split(line, parts, ",")
      for (i = 1; i <= n; i++) { gsub(/[[:space:]]/, "", parts[i]); if (parts[i] != "") print parts[i] }
    }' "$2"
}

# Save the WireGuard text that Proton shows on screen (there is no file to
# download). Reads the clipboard, or standard input if piped. The file is
# created private (600) from the start, checked, and the clipboard is cleared.
import_vpn() {
  local dir="${WIREGUARD_CONF:h}" tmp from_clipboard=0
  [[ ! -L "$WIREGUARD_CONF" ]] || die 'WireGuard config path must not be a symlink.'
  mkdir -p "$dir"; chmod 700 "$dir"
  tmp="$(mktemp "$dir/.wireguard-import.XXXXXX")"        # mktemp creates it as 600
  if [[ -t 0 ]]; then
    info 'In Proton, select the whole config text (from [Interface] to the last line) and copy it.'
    printf 'Press Return when it is copied (Ctrl-C to cancel)... '
    IFS= read -r _ || { rm -f "$tmp"; die 'Cancelled.'; }
    /usr/bin/pbpaste > "$tmp"
    from_clipboard=1
  else
    cat > "$tmp"
  fi
  # Remove Windows line endings and stray spaces that web pages sometimes add.
  /usr/bin/sed -i '' -e $'s/\r$//' -e 's/^[[:space:]]*//' "$tmp"
  local problem=''
  /usr/bin/grep -qi '^\[Interface\]' "$tmp"              || problem='no [Interface] section'
  /usr/bin/grep -qi '^PrivateKey[[:space:]]*=' "$tmp"     || problem="${problem:+$problem, }no PrivateKey"
  /usr/bin/grep -qi '^\[Peer\]' "$tmp"                   || problem="${problem:+$problem, }no [Peer] section"
  /usr/bin/grep -qi '^Endpoint[[:space:]]*=' "$tmp"       || problem="${problem:+$problem, }no Endpoint"
  if [[ -n "$problem" ]]; then
    rm -f "$tmp"
    die "That doesn't look like a complete WireGuard config ($problem). Copy all of it and try again."
  fi
  if [[ -e "$WIREGUARD_CONF" ]] && ! /usr/bin/cmp -s "$tmp" "$WIREGUARD_CONF"; then
    confirm "Replace the existing $WIREGUARD_CONF?" || { rm -f "$tmp"; info 'Kept the existing config.'; return 0; }
  fi
  mv -f "$tmp" "$WIREGUARD_CONF"
  chmod 600 "$WIREGUARD_CONF"
  if (( from_clipboard )); then
    /usr/bin/pbcopy < /dev/null
    info 'Clipboard cleared (it held your private key).'
  fi
  prepare_vpn >/dev/null    # full validation (endpoint, DNS) using the same checks as launch
  info "Saved: $WIREGUARD_CONF (private to you)."
  info "Next: $SELF --test"
}

prepare_vpn() {
  VPN_ON=0
  (( VPN )) || return 0
  if [[ ! -r "$WIREGUARD_CONF" ]]; then
    info ''
    info "VPN=1 but no WireGuard config was found at: $WIREGUARD_CONF"
    info '  1. Sign in at https://account.protonvpn.com > Downloads > WireGuard configuration'
    info '  2. Name it, Platform: GNU/Linux, NAT-PMP off, pick a server, click Create.'
    info "  3. Copy the config text Proton shows, then run: $SELF --import-vpn"
    info "  Any WireGuard provider's config works. Or set VPN=0."
    confirm 'Launch WITHOUT the VPN this time? (sites will see your real IP)' || exit 1
    return 0
  fi
  [[ ! -L "$WIREGUARD_CONF" ]] || die 'WireGuard config must not be a symlink.'
  /usr/bin/grep -qi '^[[:space:]]*\[Interface\]' "$WIREGUARD_CONF" &&
  /usr/bin/grep -qi '^[[:space:]]*PrivateKey[[:space:]]*=' "$WIREGUARD_CONF" &&
  /usr/bin/grep -qi '^[[:space:]]*\[Peer\]' "$WIREGUARD_CONF" ||
    die "$WIREGUARD_CONF does not look like a WireGuard config."
  local ep; ep="$(conf_values Endpoint "$WIREGUARD_CONF" | /usr/bin/head -n1)"
  [[ "$ep" =~ '^[0-9]+(\.[0-9]+){3}:[0-9]+$' ]] ||
    die "Endpoint must be an IPv4 address and port (got '$ep'). Proton configs already are."
  VPN_DNS="$(conf_values DNS "$WIREGUARD_CONF" | /usr/bin/grep -E '^[0-9]+(\.[0-9]+){3}$' | /usr/bin/head -n1 || true)"
  [[ -n "$VPN_DNS" ]] || die 'WireGuard config has no IPv4 DNS line.'
  conf_values AllowedIPs "$WIREGUARD_CONF" | /usr/bin/grep -qx '0.0.0.0/0' ||
    warn 'AllowedIPs lacks 0.0.0.0/0, so some sites will fail (the kill switch stops leaks).'
  local perms; perms="$(/usr/bin/stat -f '%Lp' "$WIREGUARD_CONF")"
  [[ "$perms" == ?00 ]] || warn "$WIREGUARD_CONF is readable by other users; run: chmod 600 '$WIREGUARD_CONF'"
  mkdir -p "$VPN_DIR"; chmod 700 "$VPN_DIR"
  /usr/bin/cmp -s "$WIREGUARD_CONF" "$VPN_DIR/wireguard.conf" 2>/dev/null ||
    /bin/cp -f "$WIREGUARD_CONF" "$VPN_DIR/wireguard.conf"
  chmod 600 "$VPN_DIR/wireguard.conf"
  VPN_ON=1
}

